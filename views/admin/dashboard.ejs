<!DOCTYPE html>
<html lang="fr">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Mes élèves</title>
	<link rel="stylesheet" href="/admin.css" />
	<style>
		.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 20px; }
		.cards .card { margin: 0; }
		.code { font-size: 1.6rem; letter-spacing: 0.15em; color: var(--gold); }
		.code-input { text-transform: uppercase; letter-spacing: 0.1em; }
	</style>
</head>

<body>
	<%- include("nav", { active: "eleves" }) %>

	<main>
		<h1>Mes élèves</h1>

		<% if (flash) { %>
			<div class="flash <%= flash.type %>"><%= flash.text %></div>
		<% } %>

		<div class="cards">
			<div class="card">
				<h2>Créer un compte élève</h2>
				<form method="POST" action="/admin/eleves" class="actions">
					<input type="text" name="username" placeholder="Identifiant" required autocomplete="off" />
					<input type="password" name="password" placeholder="Mot de passe (4 caractères min.)" required minlength="4" autocomplete="new-password" />
					<button type="submit">Créer le compte</button>
				</form>
			</div>
			<div class="card">
				<h2>Ajouter un élève qui a déjà un compte</h2>
				<p class="muted">Demandez-lui de générer un code (page « Mes professeurs » de son espace). Il garde ses autres professeurs.</p>
				<form method="POST" action="/admin/eleves/code" class="actions">
					<input type="text" name="code" class="code-input" placeholder="Ex. : K7PX-3QMA" required maxlength="12" autocomplete="off" />
					<button type="submit">Ajouter</button>
				</form>
			</div>
			<div class="card">
				<h2>Code pour qu'un élève vous rejoigne</h2>
				<p class="muted">L'élève l'entre dans son espace (« Mes professeurs »). Le code ne sert qu'une fois.</p>
				<% if (students.code) { %>
					<div class="actions">
						<strong class="code"><%= students.code.code %></strong>
						<span class="muted"><%= linkDurations.describe(students.code.expiresAt) %></span>
					</div>
				<% } %>
				<%- include("../partials/codeForm", { action: "/admin/code/nouveau", hasCode: Boolean(students.code), buttonClass: students.code ? "secondary" : "" }) %>
			</div>
		</div>

		<div class="card">
			<h2><%= students.mine.length %> élève<%= students.mine.length > 1 ? "s" : "" %></h2>
			<% if (students.mine.length === 0) { %>
				<p class="muted">Aucun élève pour l'instant. Créez leurs comptes ou ajoutez-les avec leur code ci-dessus.</p>
			<% } else { %>
				<div class="table-scroll">
					<table>
						<tr>
							<th>Élève</th>
							<th>Quiz terminés</th>
							<th>Moyenne</th>
							<th>Points</th>
							<th>Dernière activité</th>
							<th>Nouveau mot de passe</th>
							<th></th>
						</tr>
						<% students.mine.forEach((s) => {
							const path = "/admin/eleves/" + encodeURIComponent(s.username);
							const safeName = s.username.replace(/['"\\]/g, ""); %>
							<tr>
								<td>
									<a href="<%= path %>"><strong><%= s.username %></strong></a>
									<% if (s.teachers > 1) { %><div class="muted"><%= s.teachers %> professeurs</div><% } %>
								</td>
								<td>
									<%= s.completed %>
									<% if (s.attempts > s.completed) { %><span class="muted">(+<%= s.attempts - s.completed %> abandonné<%= s.attempts - s.completed > 1 ? "s" : "" %>)</span><% } %>
								</td>
								<td><%= s.average === null ? "—" : s.average + " %" %></td>
								<td>🪙 <%= s.points %></td>
								<td><%= s.last_activity ? s.last_activity.toLocaleString("fr-FR") : "—" %></td>
								<td>
									<form method="POST" action="<%= path %>/mot-de-passe" class="inline">
										<input type="password" name="password" required minlength="4" placeholder="••••" autocomplete="new-password" size="10" />
										<button type="submit" class="secondary">Changer</button>
									</form>
								</td>
								<td class="actions">
									<a href="<%= path %>">Historique</a>
									<form method="POST" action="<%= path %>/retirer" class="inline"
										onsubmit="return confirm('Retirer <%= safeName %> de vos élèves ? Son compte est conservé.')">
										<button type="submit" class="secondary">Retirer</button>
									</form>
									<% if (s.teachers <= 1) { %>
										<form method="POST" action="<%= path %>/supprimer" class="inline"
											onsubmit="return confirm('Supprimer le compte de <%= safeName %> et tout son historique ?')">
											<button type="submit" class="danger">Supprimer</button>
										</form>
									<% } %>
								</td>
							</tr>
						<% }) %>
					</table>
				</div>
				<p class="muted small">« Retirer » enlève l'élève de votre liste sans toucher à son compte. « Supprimer » efface son compte : seulement possible si vous êtes son unique professeur.</p>
			<% } %>
		</div>

		<% if (students.unassigned.length > 0) { %>
			<div class="card">
				<h2>Élèves sans professeur (<%= students.unassigned.length %>)</h2>
				<p class="muted">Ces élèves n'ont aucun professeur. Prenez en charge les vôtres : ils apparaîtront dans votre liste.</p>
				<div class="table-scroll">
					<table>
						<tr><th>Élève</th><th>Quiz terminés</th><th>Dernière activité</th><th></th></tr>
						<% students.unassigned.forEach((s) => { %>
							<tr>
								<td><strong><%= s.username %></strong></td>
								<td><%= s.completed %></td>
								<td><%= s.last_activity ? s.last_activity.toLocaleString("fr-FR") : "—" %></td>
								<td>
									<form method="POST" action="/admin/eleves/<%= encodeURIComponent(s.username) %>/attribuer" class="inline">
										<button type="submit">Prendre en charge</button>
									</form>
								</td>
							</tr>
						<% }) %>
					</table>
				</div>
			</div>
		<% } %>
	</main>
</body>

</html>
