<%
	// Enfant compagnon, style chibi. Paramètres : mood ("triste" | "calme" | "heureux"), equipped ({ slot: id })
	// Une pose par humeur : triste = assis, genoux serrés, tête basse ; calme = debout, main sur la hanche ;
	// heureux = en plein saut, bras levés.
	const eq = typeof equipped !== "undefined" && equipped ? equipped : {};
	const m = typeof mood !== "undefined" ? mood : "calme";
	const uid = "k" + Math.random().toString(36).slice(2, 8);
	const hair = "#3d2c7a", hairLight = "#5b45a8", skin = "#ffe3cf", skinShade = "#f6c9ad", line = "#2a1d4f", pants = "#34306b", shoes = "#ff8a5c";
	const shirt = `url(#${uid}-shirt)`;
	const star = (cx, cy, r) => {
		const pts = [];
		for (let i = 0; i < 10; i++) {
			const a = -Math.PI / 2 + (i * Math.PI) / 5;
			const rr = i % 2 ? r * 0.45 : r;
			pts.push((cx + rr * Math.cos(a)).toFixed(1) + "," + (cy + rr * Math.sin(a)).toFixed(1));
		}
		return pts.join(" ");
	};

	// Position du haut du corps et de la tête selon la pose
	const POSES = {
		triste: { upper: "translate(0 30)", head: "rotate(-9 110 140) translate(0 4)" },
		calme: { upper: "", head: "rotate(4 110 140)" },
		heureux: { upper: "translate(0 -10)", head: "rotate(-3 110 140)" }
	};
	const pose = POSES[m] || POSES.calme;

	// Bras dessiné comme un trait épais (manche), avec la main au bout
	const arm = (d, hx, hy, cls = "") =>
		`<g class="${cls}"><path d="${d}" stroke="${shirt}" stroke-width="13" stroke-linecap="round" fill="none" /><circle cx="${hx}" cy="${hy}" r="7.5" fill="${skin}" /></g>`;
%>
<svg xmlns="http://www.w3.org/2000/svg" class="kid mood-<%= m %>" viewBox="0 0 220 250" role="img" aria-label="L'enfant compagnon, humeur : <%= m %>">
	<defs>
		<radialGradient id="<%= uid %>-iris" cx="50%" cy="35%" r="70%">
			<stop offset="0%" stop-color="#9ff3ff" />
			<stop offset="55%" stop-color="#2bb3d1" />
			<stop offset="100%" stop-color="#1b4f8a" />
		</radialGradient>
		<linearGradient id="<%= uid %>-hair" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0%" stop-color="<%= hairLight %>" />
			<stop offset="100%" stop-color="<%= hair %>" />
		</linearGradient>
		<linearGradient id="<%= uid %>-shirt" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0%" stop-color="#6fd8e6" />
			<stop offset="100%" stop-color="#3ea6c4" />
		</linearGradient>
	</defs>

	<% if (m === "triste") { %>
		<!-- Ombre au sol : assis -->
		<ellipse cx="110" cy="244" rx="62" ry="6" fill="rgba(0, 0, 0, 0.25)" />
	<% } %>

	<g class="kid-body">
		<!-- Arrière : cape et cheveux -->
		<g transform="<%= pose.upper %>">
			<% if (eq.dos === "cape") { %>
				<path class="cape" d="M78 152 Q60 190 44 236 Q110 250 176 236 Q160 190 142 152 Z" fill="#e84a5f" />
				<path d="M78 152 Q70 190 60 232" stroke="#b8323f" stroke-width="3" fill="none" opacity="0.6" />
			<% } %>
			<g transform="<%= pose.head %>">
				<ellipse cx="110" cy="84" rx="66" ry="62" fill="url(#<%= uid %>-hair)" />
			</g>
		</g>

		<!-- Jambes -->
		<% if (m === "calme") { %>
			<rect x="92" y="204" width="13" height="24" rx="6" fill="<%= pants %>" />
			<rect x="115" y="204" width="13" height="24" rx="6" fill="<%= pants %>" />
			<ellipse cx="97" cy="230" rx="11" ry="6" fill="<%= shoes %>" />
			<ellipse cx="123" cy="230" rx="11" ry="6" fill="<%= shoes %>" />
		<% } else if (m === "heureux") { %>
			<!-- En plein saut : une jambe repliée, l'autre tendue -->
			<g transform="translate(0 -10)">
				<rect x="90" y="204" width="13" height="24" rx="6" fill="<%= pants %>" transform="rotate(28 96 206)" />
				<rect x="116" y="204" width="13" height="26" rx="6" fill="<%= pants %>" transform="rotate(-12 122 206)" />
				<ellipse cx="84" cy="226" rx="11" ry="6" fill="<%= shoes %>" transform="rotate(28 84 226)" />
				<ellipse cx="128" cy="232" rx="11" ry="6" fill="<%= shoes %>" />
			</g>
		<% } %>

		<!-- Haut du corps -->
		<g transform="<%= pose.upper %>">
			<% if (m === "calme") { %>
				<!-- Bras gauche le long du corps -->
				<%- arm("M78 158 Q72 176 70 192", 70, 194) %>
			<% } else if (m === "heureux") { %>
				<!-- Bras gauche levé -->
				<%- arm("M80 156 Q58 142 42 124", 39, 120) %>
			<% } %>

			<!-- T-shirt avec une étoile -->
			<path d="M80 150 Q110 140 140 150 L146 208 Q110 216 74 208 Z" fill="<%= shirt %>" />
			<polygon points="<%= star(110, 180, 11) %>" fill="#ffd27a" />

			<% if (m === "calme") { %>
				<!-- Main sur la hanche -->
				<%- arm("M140 156 Q160 172 146 194", 144, 195) %>
			<% } else if (m === "heureux") { %>
				<!-- Bras droit qui fait coucou -->
				<%- arm("M140 156 Q162 142 178 124", 181, 120, "wave-arm") %>
			<% } %>

			<!-- Cou -->
			<rect x="102" y="136" width="16" height="16" rx="6" fill="<%= skinShade %>" />
			<% if (eq.cou === "echarpe") { %>
				<rect x="84" y="140" width="52" height="13" rx="6.5" fill="#ffb347" />
				<rect x="120" y="148" width="11" height="28" rx="5" fill="#ff9f1c" transform="rotate(-10 125 150)" />
				<path d="M90 146 H132" stroke="#e8892a" stroke-width="2" stroke-dasharray="4 4" />
			<% } %>
		</g>

		<% if (m === "triste") { %>
			<!-- Assis, genoux ramenés devant le ventre, bras autour des genoux -->
			<rect x="86" y="196" width="21" height="42" rx="10" fill="<%= pants %>" />
			<rect x="113" y="196" width="21" height="42" rx="10" fill="<%= pants %>" />
			<ellipse cx="96" cy="240" rx="12" ry="6" fill="<%= shoes %>" />
			<ellipse cx="124" cy="240" rx="12" ry="6" fill="<%= shoes %>" />
			<%- arm("M80 188 Q82 216 104 214", 104, 213) %>
			<%- arm("M140 188 Q138 216 116 214", 116, 213) %>
		<% } %>

		<!-- Tête -->
		<g class="kid-head" transform="<%= pose.upper %>">
			<g transform="<%= pose.head %>">
				<ellipse cx="110" cy="92" rx="56" ry="53" fill="<%= skin %>" />
				<ellipse cx="54" cy="98" rx="7" ry="10" fill="<%= skinShade %>" />
				<ellipse cx="166" cy="98" rx="7" ry="10" fill="<%= skinShade %>" />

				<!-- Joues -->
				<ellipse cx="78" cy="116" rx="9" ry="4.5" fill="#ff9bb3" opacity="<%= m === 'triste' ? 0.3 : 0.65 %>" />
				<ellipse cx="142" cy="116" rx="9" ry="4.5" fill="#ff9bb3" opacity="<%= m === 'triste' ? 0.3 : 0.65 %>" />

				<!-- Sourcils -->
				<% if (m === "triste") { %>
					<path d="M72 80 L92 74" stroke="<%= hair %>" stroke-width="3.5" stroke-linecap="round" />
					<path d="M128 74 L148 80" stroke="<%= hair %>" stroke-width="3.5" stroke-linecap="round" />
				<% } else { %>
					<path d="M72 76 Q82 70 92 75" stroke="<%= hair %>" stroke-width="3.5" fill="none" stroke-linecap="round" />
					<path d="M128 75 Q138 70 148 76" stroke="<%= hair %>" stroke-width="3.5" fill="none" stroke-linecap="round" />
				<% } %>

				<!-- Yeux -->
				<% if (m === "heureux") { %>
					<path d="M70 102 Q82 86 94 102" stroke="<%= line %>" stroke-width="4.5" fill="none" stroke-linecap="round" />
					<path d="M126 102 Q138 86 150 102" stroke="<%= line %>" stroke-width="4.5" fill="none" stroke-linecap="round" />
				<% } else { %>
					<g class="eyes">
						<% [82, 138].forEach((x) => { const ry = m === "triste" ? 12 : 15; %>
							<ellipse cx="<%= x %>" cy="100" rx="12" ry="<%= ry %>" fill="#fff" />
							<ellipse cx="<%= x %>" cy="<%= 100 + (m === 'triste' ? 2 : 1) %>" rx="10" ry="<%= ry - 2 %>" fill="url(#<%= uid %>-iris)" />
							<ellipse cx="<%= x %>" cy="102" rx="4.5" ry="<%= ry - 7 %>" fill="#10213f" />
							<circle cx="<%= x - 4 %>" cy="95" r="3.8" fill="#fff" />
							<circle cx="<%= x + 4 %>" cy="106" r="1.8" fill="#fff" />
							<path d="M<%= x - 14 %> <%= 100 - ry + 3 %> Q<%= x %> <%= 100 - ry - 5 %> <%= x + 14 %> <%= 100 - ry + 3 %>" stroke="<%= line %>" stroke-width="3.5" fill="none" stroke-linecap="round" />
						<% }) %>
					</g>
					<% if (m === "triste") { %>
						<path class="tear" d="M150 110 Q146 118 150 122 Q154 118 150 110 Z" fill="#8fd8ff" />
					<% } %>
				<% } %>

				<!-- Bouche -->
				<% if (m === "heureux") { %>
					<path d="M96 122 Q110 142 124 122 Z" fill="#c2475f" />
					<path d="M103 132 Q110 128 117 132 Q110 138 103 132 Z" fill="#ff8fa3" />
				<% } else if (m === "triste") { %>
					<path d="M100 132 Q110 125 120 132" stroke="<%= line %>" stroke-width="3" fill="none" stroke-linecap="round" />
				<% } else { %>
					<path d="M101 125 Q110 132 119 125" stroke="<%= line %>" stroke-width="3" fill="none" stroke-linecap="round" />
				<% } %>

				<!-- Mèches sur les côtés -->
				<path d="M58 78 Q46 118 62 142 Q62 112 72 90 Z" fill="url(#<%= uid %>-hair)" />
				<path d="M162 78 Q174 118 158 142 Q158 112 148 90 Z" fill="url(#<%= uid %>-hair)" />

				<!-- Frange et mèche rebelle -->
				<path d="M54 92 Q52 38 110 30 Q168 38 166 92 L158 70 L148 88 L140 60 L126 84 L118 54 L106 82 L94 56 L86 84 L74 62 L66 86 Z" fill="url(#<%= uid %>-hair)" />
				<path class="ahoge" d="M110 32 Q100 8 124 4 Q110 14 116 32 Z" fill="<%= hairLight %>" />
				<path d="M78 46 Q110 30 142 46" stroke="#fff" stroke-width="4" fill="none" opacity="0.28" stroke-linecap="round" />

				<!-- Accessoires de tête -->
				<% if (eq.tete === "casquette") { %>
					<path d="M52 66 Q110 -2 168 66 Z" fill="#4a7bff" />
					<ellipse cx="148" cy="66" rx="36" ry="8" fill="#3560d6" />
					<circle cx="110" cy="30" r="5" fill="#ffd27a" />
				<% } else if (eq.tete === "bonnet") { %>
					<path d="M52 70 Q110 -8 168 70 Z" fill="#ff7aa8" />
					<rect x="50" y="60" width="120" height="16" rx="8" fill="#ffd1e1" />
					<circle cx="110" cy="16" r="12" fill="#fff" />
				<% } else if (eq.tete === "couronne") { %>
					<polygon points="68,46 76,14 92,36 110,6 128,36 144,14 152,46" fill="#ffd27a" stroke="#e7a93d" stroke-width="3" stroke-linejoin="round" />
					<circle cx="110" cy="30" r="5" fill="#ff7ac6" />
				<% } %>

				<% if (eq.yeux === "lunettes") { %>
					<polygon points="<%= star(82, 100, 24) %>" fill="rgba(255, 210, 122, 0.22)" stroke="#ffb300" stroke-width="3.5" stroke-linejoin="round" />
					<polygon points="<%= star(138, 100, 24) %>" fill="rgba(255, 210, 122, 0.22)" stroke="#ffb300" stroke-width="3.5" stroke-linejoin="round" />
					<path d="M100 98 H120" stroke="#ffb300" stroke-width="3.5" />
				<% } %>
			</g>
		</g>
	</g>

	<% if (eq.ami === "chat") { %>
		<g class="cat">
			<ellipse cx="186" cy="226" rx="20" ry="14" fill="#ffb86b" />
			<circle cx="190" cy="202" r="15" fill="#ffb86b" />
			<polygon points="178,194 180,178 190,190" fill="#ffb86b" />
			<polygon points="202,194 200,178 190,190" fill="#ffb86b" />
			<path d="M183 202 Q185 198 187 202" stroke="<%= line %>" stroke-width="2" fill="none" />
			<path d="M193 202 Q195 198 197 202" stroke="<%= line %>" stroke-width="2" fill="none" />
			<path d="M188 208 Q190 211 192 208" stroke="<%= line %>" stroke-width="1.6" fill="none" />
			<path class="tail" d="M204 228 Q220 214 212 198" stroke="#ffb86b" stroke-width="6" fill="none" stroke-linecap="round" />
		</g>
	<% } %>
</svg>
